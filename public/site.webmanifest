{
    "name": "Sharzhukov's Laboratory",
    "short_name": "Sharz Lab",
    "description": "Open-source collective building tools for developers. Made in EU.",
    "start_url": "/?source=pwa",
    "scope": "/",
    "display": "standalone",
    "orientation": "any",
    "theme_color": "#ff5c1f",
    "background_color": "#ffffff",
    "lang": "en",
    "dir": "ltr",
    "categories": [
        "developer",
        "productivity",
        "utilities"
    ],
    "icons": [
        {
            "src": "/img/branding/favicon-32x32.png",
            "sizes": "32x32",
            "type": "image/png"
        },
        {
            "src": "/img/branding/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/img/branding/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/img/branding/android-chrome-192x192-maskable.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/img/branding/android-chrome-512x512-maskable.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Projects",
            "url": "/projects"
        },
        {
            "name": "News",
            "url": "/news"
        },
        {
            "name": "About",
            "url": "/about"
        }
    ],
    "display_override": [
        "window-controls-overlay",
        "standalone",
        "minimal-ui",
        "browser"
    ],
    "prefer_related_applications": false,
    "edge_side_panel": {
        "preferred_width": 480
    }
}